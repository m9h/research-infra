% Pandoc LaTeX template for research manuscripts.
% Requires XeLaTeX.
\documentclass[11pt,a4paper]{scrartcl}

% Font setup (XeLaTeX).
\usepackage{fontspec}
\defaultfontfeatures{Ligatures=TeX}
\usepackage{lmodern}

% Layout.
\usepackage[margin=1in]{geometry}
\usepackage{setspace}
\onehalfspacing

% Math.
\usepackage{amsmath,amssymb}

% Graphics and tables.
\usepackage{graphicx}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{float}
\floatplacement{figure}{H}

% Hyperlinks.
\usepackage[colorlinks=true,linkcolor=blue,citecolor=blue,urlcolor=blue]{hyperref}

% Code listings (pandoc syntax highlighting).
\usepackage{fancyvrb}
\usepackage{color}
\usepackage{xcolor}
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{commandchars=\\\{\},fontsize=\small}
% Syntax highlighting: emit pandoc's OWN macros rather than hardcoding them.
% The previous version hardcoded 31 \newcommand{\...Tok} definitions plus
% \usepackage{framed}, which made every build hard-depend on framed.sty. On a system
% without texlive-framed that is a fatal 'File `framed.sty' not found'. pandoc emits
% exactly the macros a document needs, together with the packages they require, and
% emits nothing when there is no highlighted code.
$if(highlighting-macros)$
$highlighting-macros$
$endif$

% Pandoc tightlist.
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% CSL refs (pandoc 2.11+).
$if(csl-refs)$
\newlength{\cslhangindent}
\setlength{\cslhangindent}{1.5em}
\newlength{\csllabelwidth}
\setlength{\csllabelwidth}{3em}
\newenvironment{CSLReferences}[2]%
  {\begin{list}{}{%
   \setlength{\itemindent}{0pt}
   \setlength{\leftmargin}{\cslhangindent}
   \setlength{\parsep}{0pt}
   \setlength{\listparindent}{\parindent}}}
  {\end{list}}
\newcommand{\CSLBlock}[1]{\hfill\break#1\hfill\break}
\newcommand{\CSLLeftMargin}[1]{\parbox[t]{\csllabelwidth}{\honmark#1}}
\newcommand{\CSLRightInline}[1]{\parbox[t]{\linewidth - \csllabelwidth}{#1}\break}
\newcommand{\CSLIndent}[1]{\hspace{\cslhangindent}#1}
$endif$

% Title.
$if(title)$
\title{$title$}
$endif$
$if(author)$
\author{$for(author)$$author$$sep$ \and $endfor$}
$endif$
$if(date)$
\date{$date$}
$endif$

\begin{document}

$if(title)$
\maketitle
$endif$

$if(abstract)$
\begin{abstract}
$abstract$
\end{abstract}
$endif$

$if(toc)$
\tableofcontents
\newpage
$endif$

$body$

$if(bibliography)$
\bibliographystyle{plain}
$endif$

\end{document}
